# Postgres connection (set by Neon through the Vercel Marketplace)
DATABASE_URL=
# Vercel Blob token for image uploads from the admin
BLOB_READ_WRITE_TOKEN=
# Emails with admin access, comma separated. Example: a@x.com,b@y.com
ADMIN_EMAILS=
# Development/testing only: sample | empty | error
NUVA_SAMPLE_DATA=
# Public site URL, e.g. https://nuva.mx (the ONLY allowed NEXT_PUBLIC_* variable)
NEXT_PUBLIC_SITE_URL=

# --- Security and integrations layer (see docs/INTEGRATIONS.md) ---
# All non-public variables must be marked "Sensitive" in Vercel, with separate values per environment.

# Rate limiting (Upstash Redis). Set BOTH or NEITHER. The Vercel Marketplace names
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted. Without them, limits are per instance (in memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error reporting (optional, server and edge only). Empty disables Sentry entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Log level: debug | info | warn | error (default info)
LOG_LEVEL=

# Salt (min 32 chars) used to store client IPs only as salted SHA-256 in the audit trail. Empty = IPs are not stored.
AUDIT_IP_SALT=

# Example provider (stub used to prove the integrations layer). NEVER enable in production:
# enabling it when VERCEL_ENV=production stops the server at boot.
INTEGRATION_EXAMPLE_ENABLED=
INTEGRATION_EXAMPLE_API_KEY=
# Key rotation: set the new key here, swap, then remove. Same for the webhook secret.
INTEGRATION_EXAMPLE_API_KEY_NEXT=
# Webhook signing secret, min 32 chars
INTEGRATION_EXAMPLE_WEBHOOK_SECRET=
INTEGRATION_EXAMPLE_WEBHOOK_SECRET_NEXT=
# Must be https and on the provider allowlist (default https://api.example.test)
INTEGRATION_EXAMPLE_BASE_URL=

# Supplier catalog (Innovation Line; see docs/INTEGRATIONS.md). Server-side only, mark all as Sensitive in Vercel.
INTEGRATION_INNOVATION_ENABLED=
# Header token the supplier calls "auth-token"
INTEGRATION_INNOVATION_API_KEY=
# Key rotation: set the new token here, swap, then remove
INTEGRATION_INNOVATION_API_KEY_NEXT=
# Supplier "User" and "Clave" (query parameters)
INTEGRATION_INNOVATION_USER=
INTEGRATION_INNOVATION_PASSWORD=
# false hides the public catalog section without touching stored data (default true)
INTEGRATION_INNOVATION_CATALOG_PUBLIC=
# Local testing only: skip the supplier query-window guard. Rejected in production.
INTEGRATION_INNOVATION_IGNORE_WINDOW=
# Bearer secret (min 32 chars) for GET /api/cron/innovation-sync. Vercel Cron sends it automatically.
CRON_SECRET=

# Set to true ONLY when running behind a proxy that overwrites x-real-ip / x-forwarded-for (not needed on Vercel).
# Otherwise the client IP is 'unknown' and rate limits share one bucket.
TRUST_PROXY_HEADERS=
